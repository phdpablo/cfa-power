@techreport{wang2023,
  type = {Preprint},
  title = {How to {{Conduct Power Analysis}} for {{Structural Equation Models}}: {{A Practical Primer}}},
  shorttitle = {How to {{Conduct Power Analysis}} for {{Structural Equation Models}}},
